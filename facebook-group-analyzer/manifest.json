{
  "manifest_version": 3,
  "name": "Group Insight — Facebook Group Analyzer",
  "version": "1.0.0",
  "description": "Scrape, index and analyze posts, comments and engagement from a Facebook group you belong to. All data stays on your machine.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://m.facebook.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Group Insight",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/groups/*",
        "https://web.facebook.com/groups/*"
      ],
      "js": [
        "src/lib/analyzer.js",
        "src/content/extractors.js",
        "src/content/scraper.js"
      ],
      "css": ["src/content/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
